[Unit]
Description=Dyson Pi - Vis Nav pneumatic button pusher
Documentation=file:///opt/dyson-pi/README.md
After=network-online.target time-sync.target avahi-daemon.service
Wants=network-online.target
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=dyson-pi
Group=dyson-pi
SupplementaryGroups=gpio
WorkingDirectory=/var/lib/dyson-pi
Environment=PYTHONUNBUFFERED=1
Environment=DYSON_PI_CONFIG=/etc/dyson-pi/config.yaml
# lgpio writes notification pipes into LG_WD; keep it on tmpfs.
Environment=LG_WD=/run/dyson-pi

# Relay OFF before start and after ANY exit (clean stop, crash, kill -9).
# "+" = run as root, outside the sandbox. pinctrl latches the level after exit.
ExecStartPre=+/opt/dyson-pi/deploy/relay-off.sh
ExecStart=/opt/dyson-pi/.venv/bin/python -m dyson_pi --config /etc/dyson-pi/config.yaml
ExecStopPost=+/opt/dyson-pi/deploy/relay-off.sh

Restart=always
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=15
# The app pings the watchdog from its event loop; a hang -> restart.
WatchdogSec=30

RuntimeDirectory=dyson-pi
RuntimeDirectoryPreserve=yes
StateDirectory=dyson-pi
LogsDirectory=dyson-pi

# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/dyson-pi /var/log/dyson-pi
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
